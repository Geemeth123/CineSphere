<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="1024.0" spacing="20.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.snackbar.SnackPOSController" stylesheets="@../ticket/ticket.css">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5.0">
            <Label text="Point of Sale" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
            <Label text="Process snack sales and generate bills." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
        </VBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Left Side: Product Selection (Card Deck) -->
        <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="validation-card" style="-fx-padding: 20px;">
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Available Snacks" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="categoryFilter" promptText="All Categories" styleClass="search-combo" style="-fx-pref-width: 150;" />
                <TextField fx:id="searchField" promptText="Search snacks..." styleClass="search-field" />
            </HBox>

            <!-- FlowPane for Snack Cards inside ScrollPane -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <content>
                    <FlowPane fx:id="cardsContainer" hgap="15.0" vgap="15.0" style="-fx-background-color: transparent;" />
                </content>
            </ScrollPane>
        </VBox>

        <!-- Right Side: Cart & Checkout -->
        <VBox prefWidth="450.0" spacing="15.0" styleClass="validation-card" style="-fx-padding: 20px;">
            <Label text="Current Order" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
            
            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" styleClass="shows-table">
                <columns>
                    <TableColumn fx:id="cartColName" prefWidth="130.0" text="Item" />
                    <TableColumn fx:id="cartColQty" prefWidth="60.0" text="Qty" />
                    <TableColumn fx:id="cartColPrice" prefWidth="70.0" text="Price" />
                    <TableColumn fx:id="cartColTotal" prefWidth="70.0" text="Total" />
                    <TableColumn fx:id="cartColAction" prefWidth="90.0" text="Action" />
                </columns>
            </TableView>

            <!-- Booking Lookup Section -->
            <VBox spacing="10.0" styleClass="validation-card" style="-fx-padding: 15px; -fx-background-color: #f8f9fa;">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Customer:" style="-fx-font-size: 14px; -fx-text-fill: #495057; -fx-font-weight: bold;" />
                    <ComboBox fx:id="customerTypeCombo" styleClass="search-combo" prefWidth="150.0" />
                </HBox>
                <VBox fx:id="bookingLookupBox" spacing="10.0" managed="false" visible="false">
                    <HBox spacing="10.0">
                        <TextField fx:id="bookingIdField" promptText="Booking ID (e.g. BK-1 or 1)" HBox.hgrow="ALWAYS" styleClass="search-field" />
                        <Button text="Lookup" onAction="#handleBookingLookup" styleClass="action-btn" />
                    </HBox>
                    <VBox fx:id="bookingDetailsBox" spacing="5.0" managed="false" visible="false" styleClass="validation-card" style="-fx-background-color: #e6f2ff; -fx-padding: 10px; -fx-border-color: #b3d9ff;">
                        <Label fx:id="bdMovieLabel" text="Movie: N/A" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #004080;" />
                        <Label fx:id="bdHallLabel" text="Hall: N/A" style="-fx-font-size: 12px; -fx-text-fill: #004080;" />
                        <Label fx:id="bdSeatsLabel" text="Seats: N/A" style="-fx-font-size: 12px; -fx-text-fill: #004080;" />
                        <Label fx:id="bdTimeLabel" text="Time: N/A" style="-fx-font-size: 12px; -fx-text-fill: #004080;" />
                    </VBox>
                </VBox>
            </VBox>

            <!-- Totals Section -->
            <VBox spacing="10.0" styleClass="validation-card" style="-fx-padding: 15px; -fx-background-color: #f8f9fa;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Subtotal:" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="subtotalLabel" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                </HBox>
                
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Discount Code:" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
                    <TextField fx:id="discountCodeField" promptText="Enter code" prefWidth="120.0" styleClass="search-field" />
                    <Button text="Apply" onAction="#handleApplyDiscount" styleClass="secondary-action-btn" />
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Discount:" style="-fx-font-size: 14px; -fx-text-fill: #28a745;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="discountLabel" text="-0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #28a745;" />
                </HBox>

                <HBox style="-fx-border-width: 1px 0 0 0; -fx-border-color: #cccccc; -fx-padding: 10px 0 0 0;" alignment="CENTER_LEFT">
                    <Label text="Total:" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalLabel" text="0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
                </HBox>
            </VBox>

            <Button text="Complete Sale" onAction="#handleCheckout" maxWidth="Infinity" styleClass="action-btn" style="-fx-font-size: 18px; -fx-padding: 15px;" />
        </VBox>
    </HBox>
</VBox>
