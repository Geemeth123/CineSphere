<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../ticket/ticket.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.snackbar.SnackReceiptController">
<VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: #ffffff; -fx-padding: 30 40 40 40;">
    
    <!-- Top Row with Back Button alignment -->
    <HBox alignment="CENTER_LEFT" maxWidth="380">
        <Button text="← Back to Bills" styleClass="secondary-action-btn" onAction="#handleBack" />
    </HBox>
    
    <VBox spacing="5" alignment="CENTER" maxWidth="600">
        <Label text="Snack Transaction Receipt" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
        <Label text="Review transaction details and customer receipt." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
    </VBox>

    <!-- Centered Receipt Card -->
    <VBox fx:id="receiptCard" alignment="CENTER" maxWidth="380" minWidth="380" maxHeight="-Infinity" styleClass="receipt-card" spacing="20">
        <padding>
            <Insets top="40" right="30" bottom="40" left="30" />
        </padding>
        <Label text="CINESPHERE SNACKS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
        <Label fx:id="saleIdLabel" text="Sale ID: RCPT-0" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
        
        <VBox spacing="8" alignment="TOP_LEFT" style="-fx-padding: 10 0;">
            <Label fx:id="dateLabel" text="Date: YYYY-MM-DD" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
            <Label fx:id="cashierLabel" text="Cashier: Staff" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
            <Label fx:id="bookingIdLabel" text="Booking ID: N/A" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
            <Label fx:id="seatLabel" text="Seat Number: N/A" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
        </VBox>
        
        <Separator style="-fx-padding: 5 0;" />
        
        <VBox fx:id="itemsContainer" spacing="10" alignment="TOP_LEFT" style="-fx-padding: 5 0;">
            <!-- Dynamically populated rows -->
        </VBox>
        
        <Separator style="-fx-padding: 5 0;" />
        
        <VBox spacing="8" style="-fx-padding: 5 0;">
            <HBox alignment="CENTER_LEFT">
                <Label text="Subtotal:" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="subtotalLabel" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Discount:" style="-fx-font-size: 14px; -fx-text-fill: #28a745;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="discountLabel" text="-0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #28a745;" />
            </HBox>
            <HBox style="-fx-padding: 5 0 0 0;" alignment="CENTER_LEFT">
                <Label text="Total Paid:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalLabel" text="0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
            </HBox>
        </VBox>
        
        <Label fx:id="receiptBadgeLabel" text="PAID" styleClass="status-badge" style="-fx-font-size: 14px; -fx-translate-y: 20px;" />
    </VBox>

    <!-- Action Buttons below Centered Receipt Card -->
    <HBox alignment="CENTER" spacing="20" maxWidth="380">
        <Button text="Download Receipt Image" styleClass="primary-action-btn" onAction="#handleDownloadReceipt" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
    </HBox>

</VBox>
</ScrollPane>
