<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.snackbar.AddSnackController" stylesheets="@../ticket/ticket.css">
    <VBox spacing="30.0" style="-fx-background-color: #ffffff; -fx-padding: 40;">
        
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5.0">
                <Label fx:id="titleLabel" text="Add New Snack" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                <Label text="Enter the snack details below." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleBack" text="← Back to Management" styleClass="secondary-action-btn" />
        </HBox>

        <VBox alignment="CENTER" spacing="30.0">
            <VBox styleClass="validation-card" style="-fx-padding: 30px; -fx-max-width: 600px;" spacing="20.0">
                <Label text="Basic Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                
                <VBox spacing="5.0">
                    <Label text="Snack Name" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                    <TextField fx:id="nameField" promptText="e.g. Popcorn Large" styleClass="search-field" style="-fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Category" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                    <ComboBox fx:id="categoryCombo" promptText="Select Category" styleClass="search-combo" maxWidth="Infinity" style="-fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Description" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                    <TextArea fx:id="descArea" prefRowCount="3" promptText="Optional details" styleClass="search-field" style="-fx-font-size: 14px; -fx-padding: 5px;" wrapText="true" />
                </VBox>

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Selling Price ($)" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                        <TextField fx:id="priceField" promptText="0.00" styleClass="search-field" style="-fx-font-size: 14px;" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Cost Price ($)" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                        <TextField fx:id="costPriceField" promptText="0.00" styleClass="search-field" style="-fx-font-size: 14px;" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Stock Quantity" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                        <TextField fx:id="quantityField" promptText="0" styleClass="search-field" style="-fx-font-size: 14px;" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Min Stock Alert" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                        <TextField fx:id="minStockField" promptText="10" styleClass="search-field" style="-fx-font-size: 14px;" />
                    </VBox>
                </HBox>

                <VBox spacing="5.0">
                    <Label text="Status" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                    <ComboBox fx:id="statusCombo" promptText="Select Status" styleClass="search-combo" maxWidth="Infinity" style="-fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Snack Image" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Button mnemonicParsing="false" text="Choose File" onAction="#handleChooseImage" styleClass="secondary-action-btn" />
                        <Label fx:id="imagePathLabel" text="No file selected..." style="-fx-font-size: 13px; -fx-font-style: italic; -fx-text-fill: #6c757d;" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 30px 0 0 0;">
                    <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" styleClass="secondary-action-btn" />
                    <Button mnemonicParsing="false" onAction="#handleSave" text="Save Snack" styleClass="primary-action-btn" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
