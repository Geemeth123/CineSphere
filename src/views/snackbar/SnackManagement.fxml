<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="1024.0" spacing="30.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.snackbar.SnackManagementController" stylesheets="@../ticket/ticket.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <VBox spacing="5.0">
            <Label text="Snack Management" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
            <Label text="Manage snack inventory, pricing, and stock." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        
        <ComboBox fx:id="categoryFilter" promptText="All Categories" styleClass="search-combo" style="-fx-pref-width: 150;" />
        <TextField fx:id="searchField" promptText="Search snacks..." styleClass="search-field" />
        
        <Button mnemonicParsing="false" onAction="#onAddSnack" text="+ Add Snack" styleClass="action-btn" />
    </HBox>

    <!-- FlowPane for Snack Cards -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardsContainer" hgap="30" vgap="30" style="-fx-background-color: transparent;" />
    </ScrollPane>
</VBox>
