<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ticket.MovieDetailsController" stylesheets="@ticket.css">
    <StackPane>
        <VBox fx:id="contentContainer" spacing="0" style="-fx-background-color: #ffffff;">
        
        <!-- Hero Banner Area -->
        <StackPane fx:id="heroBanner" minHeight="300" maxHeight="300">
            <!-- Semi-transparent overlay to make back button readable -->
            <AnchorPane style="-fx-background-color: rgba(0, 0, 0, 0.45);">
                <Button text="← Back to Now Showing" styleClass="back-btn" onAction="#handleBack" AnchorPane.leftAnchor="30" AnchorPane.topAnchor="30" />
            </AnchorPane>
        </StackPane>

        <!-- Main Details Content Area -->
        <VBox spacing="25" style="-fx-padding: 30;">
            
            <HBox spacing="35" alignment="TOP_LEFT">
                <!-- Poster Card -->
                <VBox styleClass="poster-card-container">
                    <ImageView fx:id="posterImage" fitWidth="220" fitHeight="330" pickOnBounds="true" preserveRatio="true" />
                </VBox>

                <!-- Movie Meta Details -->
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" text="Movie Title" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #212529;" wrapText="true" />
                    
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="yearLabel" text="2024" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                        <Label text="•" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                        <Label fx:id="durationLabel" text="120 mins" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                        <Label text="•" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                        <Label fx:id="languageLabel" text="EN" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
                    </HBox>

                    <!-- Rating and Popularity -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="ratingLabel" text="⭐ 0.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffc107;" />
                        <Label text="/ 10" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ffc107;" />
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="popularityLabel" text="Popularity: 0.0" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
                    </HBox>

                    <!-- Genres Box -->
                    <FlowPane fx:id="genresBox" hgap="10" vgap="10" style="-fx-padding: 5 0;" />

                    <!-- Action Buttons -->
                    <HBox spacing="15" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="actionButton" text="Book Tickets" styleClass="primary-action-btn" onAction="#handleBookTickets" />
                    </HBox>
                </VBox>
            </HBox>

            <!-- Synopsis/Overview -->
            <VBox spacing="10">
                <Label text="Synopsis" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                <Label fx:id="taglineLabel" text="" style="-fx-font-style: italic; -fx-font-size: 15px; -fx-text-fill: #495057;" wrapText="true" />
                <Label fx:id="overviewLabel" text="Loading synopsis..." wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #6c757d; -fx-line-spacing: 5px;" />
            </VBox>

        </VBox>
        
        <!-- Loading Overlay -->
        <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="15" style="-fx-background-color: white;">
            <padding>
                <Insets top="100" />
            </padding>
            <ProgressIndicator progress="-1.0" />
            <Label text="Please wait, loading movie details..." style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
        </VBox>
    </StackPane>
</ScrollPane>
