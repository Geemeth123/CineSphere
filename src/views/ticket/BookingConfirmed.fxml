<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@ticket.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ticket.BookingConfirmedController">
<VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: #ffffff; -fx-padding: 30 40 40 40;">
    
    <VBox spacing="5" alignment="CENTER" maxWidth="600">
        <Label text="Booking Confirmed!" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #198754;" />
        <Label text="Your ticket has been booked and confirmed successfully." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
    </VBox>

    <!-- Centered Ticket Card -->
    <VBox fx:id="receiptCard" alignment="CENTER" maxWidth="380" minWidth="380" maxHeight="-Infinity" styleClass="receipt-card" spacing="20">
        <padding>
            <Insets top="40" right="30" bottom="40" left="30" />
        </padding>
        
        <Label text="CINESPHERE TICKET" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
        <Label fx:id="bookingIdLabel" text="Booking ID: BK-0" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;" />
        
        <!-- QR Container -->
        <VBox fx:id="qrCodeContainer" alignment="CENTER" styleClass="qr-placeholder" prefWidth="180" prefHeight="180" minWidth="180" minHeight="180" maxWidth="180">
            <Label text="[QR Code]" style="-fx-text-fill: #adb5bd; -fx-font-size: 14px;" />
        </VBox>
        
        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="movieTitleLabel" text="Movie Title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
            <Label fx:id="showtimeLabel" text="14:00 - Hall A" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
        </VBox>
        
        <Separator style="-fx-padding: 5 0;" />
        
        <Label fx:id="seatsLabel" text="Seats: -" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
        
        <Separator style="-fx-padding: 5 0;" />
        
        <VBox spacing="8" style="-fx-padding: 5 0;">
            <HBox alignment="CENTER_LEFT">
                <Label text="Subtotal:" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="subtotalLabel" text="\$0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Discount:" style="-fx-font-size: 14px; -fx-text-fill: #28a745;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="discountLabel" text="-\$0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #28a745;" />
            </HBox>
            <HBox style="-fx-padding: 5 0 0 0;" alignment="CENTER_LEFT">
                <Label text="Total Paid:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalPaidLabel" text="\$0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0d6efd;" />
            </HBox>
        </VBox>
        
        <Label fx:id="ticketBadgeLabel" text="CONFIRMED" styleClass="status-badge" style="-fx-font-size: 14px; -fx-translate-y: 20px;" />
    </VBox>
    
    <!-- Action Buttons -->
    <VBox spacing="15" alignment="CENTER" maxWidth="380">
        <Button text="Download Digital Receipt (PNG)" styleClass="primary-action-btn" maxWidth="Infinity" onAction="#handleDownloadReceipt" />
        <HBox alignment="CENTER" spacing="20">
            <Button text="Back to Dashboard" styleClass="secondary-action-btn" onAction="#handleBackToDashboard" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            <Button text="Ticket Desk →" styleClass="secondary-action-btn" onAction="#handleTicketDesk" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </VBox>
</VBox>
</ScrollPane>
